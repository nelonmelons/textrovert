{
  "expo": {
    "name": "Textrovert",
    "slug": "textrovert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "textrovert",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.textrovert.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Textrovert Messages",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.textrovert.messages"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false,
        "UTExportedTypeDeclarations": [
          {
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeDescription": "Textrovert Messages",
            "UTTypeIdentifier": "com.textrovert.messages",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "textrovert"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "package": "com.textrovert.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Textrovert",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-contacts",
        {
          "contactsPermission": "Textrovert reads your contacts only when you tap Import, to find your people."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Textrovert uses the photo you pick to answer your question."
        }
      ],
      "expo-video"
    ]
  }
}
