{
  "name": "@textrovert/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:ios": "expo prebuild --platform ios --clean && xcodebuild -workspace ios/*.xcworkspace -scheme Textrovert -configuration Release -sdk iphonesimulator -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO",
    "typecheck": "tsc --noEmit",
    "vendor:wrapped": "node scripts/vendor-wrapped.js",
    "postinstall": "node scripts/vendor-wrapped.js",
    "prestart": "node scripts/vendor-wrapped.js",
    "preweb": "node scripts/vendor-wrapped.js",
    "pretypecheck": "node scripts/vendor-wrapped.js",
    "prebuild:ios": "node scripts/vendor-wrapped.js"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-contacts": "~58.0.11",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
